# Copiar a .env en desarrollo local. En Vercel, configurar cada una
# como variable de entorno del proyecto (Settings → Environment Variables).
# Nombres verificados contra el código real (grep de process.env.*).

MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/gladiadores
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga
NODE_ENV=production
PORT=3001

# URLs propias, usadas para armar enlaces en mensajes/checkout
FRONTEND_URL=https://www.gladiadoresoffroad.com
BACKEND_URL=https://gladiadores-backend.vercel.app

# Mercado Pago
MP_ACCESS_TOKEN=tu_access_token_de_mercadopago
# Crítico: sin esta variable, routes/webhooks.js rechaza TODOS los avisos
# de pago (fail-closed). Se obtiene en el panel de Mercado Pago, sección
# de webhooks/notificaciones del negocio.
MP_WEBHOOK_SECRET=tu_secret_de_webhook_de_mercadopago

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=tu_account_sid
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
